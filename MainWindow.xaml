<Window x:Class="Dota2ChatExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dota2ChatExtractor"
        Title="DOTA2 Chat Spy" Icon="Assets/ChatSpy.ico" Width="1160" Height="790" MinWidth="850" MinHeight="560"
        Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.83" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.43" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ModeOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="6" Padding="12,7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Elevated}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource AccentTint}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TranscriptTemplate">
            <Border Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel>
                    <Border Padding="20,16" Background="{DynamicResource Elevated}" CornerRadius="11,11,0,0"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="19" Foreground="{DynamicResource Ink}" />
                            <TextBlock Text="{Binding Metadata}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="10,6,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="MessageBackground" Padding="9,8" Margin="0,2" CornerRadius="7" Background="{DynamicResource Canvas}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Clock}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,2,7,0" />
                                        <StackPanel Grid.Column="1">
                                            <DockPanel x:Name="MessageHeader">
                                                <TextBlock x:Name="ScoreText" DockPanel.Dock="Right" Text="{Binding Score}" FontSize="12" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Muted}" ToolTip="{DynamicResource Ui.ScoreHint}" />
                                                <Image x:Name="HeroIcon" DockPanel.Dock="Left" Source="{Binding Hero.Icon}" Width="20" Height="20"
                                                       Margin="0,0,6,0" VerticalAlignment="Top" ToolTip="{Binding Hero.DisplayName}" />
                                                <local:TranscriptText x:Name="Author" Parts="{Binding AuthorParts}" FontSize="13" FontWeight="SemiBold"
                                                                      SlotBackground="{DynamicResource NickBackground}" TextWrapping="Wrap"
                                                                      Foreground="{DynamicResource Muted}" />
                                            </DockPanel>
                                            <local:TranscriptText x:Name="MessageText" Parts="{Binding BodyParts}" SlotBackground="{DynamicResource NickBackground}"
                                                                  TextWrapping="Wrap" Foreground="{DynamicResource Ink}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                        <Setter TargetName="MessageBackground" Property="Background" Value="{DynamicResource AccentTint}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Hero.Icon, FallbackValue={x:Null}}" Value="{x:Null}">
                                        <Setter TargetName="HeroIcon" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:MessageKind.Interlude}">
                                        <Setter TargetName="MessageBackground" Property="Background" Value="Transparent" />
                                        <Setter TargetName="MessageHeader" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource Muted}" />
                                        <Setter TargetName="MessageText" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:MessageKind.FinalHeading}">
                                        <Setter TargetName="MessageBackground" Property="Background" Value="{DynamicResource Elevated}" />
                                        <Setter TargetName="MessageBackground" Property="Margin" Value="0,12,0,3" />
                                        <Setter TargetName="Author" Property="Foreground" Value="{DynamicResource Ink}" />
                                        <Setter TargetName="Author" Property="FontSize" Value="15" />
                                        <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource Muted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:MessageKind.FinalScore}">
                                        <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="MessageBackground" Property="Padding" Value="9,5" />
                                        <Setter TargetName="ScoreText" Property="ToolTip" Value="{DynamicResource Ui.FinalScoreHint}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="26,21,26,18" LastChildFill="True">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Action}" Click="OpenDocs_Click"
                    ToolTip="{DynamicResource Ui.OpenDocs}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="OpenDota" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="8,0,0,0" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Action}"
                    Margin="0,0,8,0" ToolTip="{DynamicResource Ui.LightTheme}" AutomationProperties.Name="{DynamicResource Ui.LightTheme}"
                    Click="Theme_Click">
                <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE706;" />
            </Button>
            <ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="68" Height="36"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      AutomationProperties.Name="{DynamicResource Ui.Language}"
                      ToolTip="{DynamicResource Ui.Language}" SelectedIndex="0">
                <ComboBoxItem Content="EN" />
                <ComboBoxItem Content="RU" />
            </ComboBox>
            <Border DockPanel.Dock="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ModeOption}" GroupName="HistoryMode" Content="{DynamicResource Ui.ByMatch}"
                                 IsChecked="True" Click="Mode_Click" />
                    <RadioButton x:Name="FeedMode" Style="{StaticResource ModeOption}" GroupName="HistoryMode" Content="{DynamicResource Ui.Feed}"
                                 Click="Mode_Click" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/ChatSpy.png" Width="49" Height="49" Margin="0,0,13,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DOTA2 Chat Spy" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Ui.Subtitle}" Foreground="{DynamicResource Muted}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                Margin="26,0,26,16" Padding="14,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Label Content="Dota Account ID" Target="{Binding ElementName=AccountInput}" VerticalAlignment="Center"
                           Padding="0" Margin="0,0,12,0" FontWeight="SemiBold" />
                    <TextBox x:Name="AccountInput" Width="145" Height="36" MaxLength="10" VerticalContentAlignment="Center"
                             KeyDown="AccountInput_KeyDown" Margin="0,0,8,0" />
                    <Button x:Name="LoadButton" Style="{StaticResource PrimaryAction}" Content="{DynamicResource Ui.LoadMatches}" Click="Load_Click" />
                    <Button x:Name="HistoryButton" Style="{StaticResource Action}" Content="{DynamicResource Ui.IdHistory}" Margin="8,0,0,0" Click="History_Click" />
                </StackPanel>
                <ProgressBar x:Name="Activity" DockPanel.Dock="Right" IsIndeterminate="True" Width="100" VerticalAlignment="Center"
                             Margin="16,0,0,0" Visibility="Collapsed" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Content="{DynamicResource Ui.Stop}" Click="Cancel_Click"
                        Visibility="Collapsed" />
                <Button x:Name="ClearCacheButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Content="{DynamicResource Ui.ClearCache}"
                        ToolTip="{DynamicResource Ui.ClearCacheHint}"
                        Margin="0,0,8,0" Click="ClearCache_Click" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="26,0,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="308" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MatchSidebar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="14,13,14,10">
                        <TextBlock x:Name="MatchCount" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="{DynamicResource Ui.Matches}" FontSize="21" FontWeight="SemiBold" />
                    </DockPanel>
                    <ListBox x:Name="MatchList" Grid.Row="1" Margin="7,0" Padding="0" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{DynamicResource Ui.PlayerMatches}" SelectionChanged="MatchList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Elevated}" /></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentTint}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="Outcome" DockPanel.Dock="Right" Text="{Binding Result}" Foreground="{DynamicResource Muted}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ChatStatus}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWin}" Value="True"><Setter TargetName="Outcome" Property="Foreground" Value="{DynamicResource Win}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsWin}" Value="False"><Setter TargetName="Outcome" Property="Foreground" Value="{DynamicResource Loss}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <UniformGrid Grid.Row="2" Columns="2" Margin="10,9,10,10">
                        <Button x:Name="ScanButton" Style="{StaticResource Action}" Content="{DynamicResource Ui.ScanChats}" Margin="0,0,4,0"
                                ToolTip="{DynamicResource Ui.ScanChatsHint}" Click="Scan_Click" IsEnabled="False" />
                        <Button x:Name="MoreButton" Style="{StaticResource Action}" Content="{DynamicResource Ui.MoreMatches}" Margin="4,0,0,0"
                                Click="More_Click" IsEnabled="False" />
                    </UniformGrid>
                </Grid>
            </Border>

            <Border x:Name="ChatPane" Grid.Column="2" CornerRadius="12" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ChatToolbar" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="11,11,0,0" Padding="14,8"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel x:Name="MatchActions" DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Action}" ToolTip="{DynamicResource Ui.OpenMatch}"
                                        AutomationProperties.Name="{DynamicResource Ui.OpenMatch}" Click="OpenMatch_Click" Margin="0,0,7,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" />
                                </Button>
                                <Button x:Name="ExportButton" Style="{StaticResource Action}" Click="Export_Click"
                                        ToolTip="{DynamicResource Ui.SaveMatchHint}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" Margin="0,0,7,0" />
                                        <TextBlock Text="{DynamicResource Ui.SavePng}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Center" MinHeight="36">
                                <CheckBox x:Name="AllAuthors" Content="{DynamicResource Ui.AllPlayers}" MinHeight="36" Margin="0,0,12,0"
                                          Checked="Filters_Changed" Unchecked="Filters_Changed" />
                                <CheckBox x:Name="ShowScore" Content="{DynamicResource Ui.ScoreAndDeaths}" MinHeight="36"
                                          ToolTip="{DynamicResource Ui.ScoreAndDeathsHint}"
                                          Checked="Filters_Changed" Unchecked="Filters_Changed" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="13,12" Visibility="Collapsed">
                        <ContentControl x:Name="TranscriptView" ContentTemplate="{StaticResource TranscriptTemplate}"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                    </ScrollViewer>
                    <ListBox x:Name="FeedList" Grid.Row="1" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                             Padding="12,10"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.ScrollChanged="FeedList_ScrollChanged"
                             AutomationProperties.Name="{DynamicResource Ui.MessageFeed}">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer x:Name="FeedScroller" Padding="{TemplateBinding Padding}" Focusable="False"
                                              CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,15" MaxWidth="960">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TranscriptTemplate}"
                                                    HorizontalContentAlignment="Stretch" />
                                    <Button Style="{StaticResource Action}" Content="PNG" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,13,14,0" ToolTip="{DynamicResource Ui.SaveChatHint}" Click="Export_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="FeedFooter" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="14,8">
                        <DockPanel>
                            <Button x:Name="FeedMoreButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Content="{DynamicResource Ui.MoreMatches}"
                                    Click="FeedMore_Click" />
                            <Button x:Name="ExportFeedButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryAction}" Content="{DynamicResource Ui.SaveFeed}"
                                    Margin="0,0,8,0" ToolTip="{DynamicResource Ui.SaveFeedHint}" Click="ExportFeed_Click" />
                            <TextBlock x:Name="FeedCount" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" />
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="370">
                        <Border Width="58" Height="58" CornerRadius="16" Background="{DynamicResource AccentTint}" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F2;" Foreground="{DynamicResource Accent}" FontSize="25" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="{DynamicResource Ui.SelectMatch}" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" Margin="0,13,0,5" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyBody" Text="{DynamicResource Ui.ChatEmpty}" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{DynamicResource Muted}" />
                        <Button x:Name="RetryButton" Style="{StaticResource Action}" Content="{DynamicResource Ui.LoadChat}" Click="Retry_Click"
                                HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="3" Margin="27,10,27,12" FontSize="12" Foreground="{DynamicResource Muted}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
